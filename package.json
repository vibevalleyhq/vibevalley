{
  "name": "vibevalley",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "golden:update": "vpx scripts/golden-update.ts",
    "desktop:dev": "vp run --filter @vibevalley/desktop dev",
    "notes:catalog": "vpx scripts/agent-notes.ts --write",
    "site:check": "pnpm --dir site install && pnpm --dir site run check",
    "site:build": "pnpm --dir site install && pnpm --dir site run build",
    "site:deploy": "pnpm --dir site install && pnpm --dir site run deploy",
    "package:mac": "vp run --filter @vibevalley/desktop package",
    "capabilities": "vpx scripts/capabilities.ts",
    "api:client": "vpx scripts/api-client.ts",
    "i18n:gen": "vpx scripts/i18n.ts gen",
    "health": "vpx packages/health/src/cli.ts --config scripts/health.config.ts",
    "health:write": "vpx packages/health/src/cli.ts --config scripts/health.config.ts --write"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@vibevalley/health": "workspace:*",
    "effect": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
