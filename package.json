{
  "name": "vibevalley",
  "private": true,
  "type": "module",
  "imports": {
    "#migration-inputs": "./scripts/style-migration-inputs.ts"
  },
  "exports": {
    "./style-migration": "./scripts/style-migration-graph.ts"
  },
  "scripts": {
    "prepare": "vp config --hooks --no-agent && vp run packages:build",
    "golden:update": "vpx scripts/golden-update.ts",
    "desktop:dev": "vp run --filter @vibevalley/desktop dev",
    "notes:catalog": "vpx scripts/agent-notes.ts --write",
    "site:deploy": "vp run --filter @vibevalley/site deploy",
    "package:mac": "vp run --filter @vibevalley/desktop package",
    "release": "vpx scripts/release.ts",
    "capabilities": "vpx scripts/capabilities.ts",
    "api:client": "vpx scripts/api-client.ts",
    "i18n:gen": "vpx scripts/i18n.ts gen",
    "health": "vpx packages/health/src/cli.ts --config scripts/health.config.ts",
    "health:write": "vpx packages/health/src/cli.ts --config scripts/health.config.ts --write",
    "effect:write": "vpx scripts/effect-check.ts --write",
    "practice:write": "vpx scripts/practice-audit.ts --write"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vibevalley/desktop": "workspace:*",
    "@vibevalley/health": "workspace:*",
    "@vibevalley/i18n": "workspace:*",
    "@vibevalley/protocol": "workspace:*",
    "@vibevalley/server": "workspace:*",
    "@vibevalley/testkit": "workspace:*",
    "effect": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "knip": "catalog:",
    "lightningcss": "catalog:",
    "parse5": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
