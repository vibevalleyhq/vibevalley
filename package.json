{
  "name": "vibevalley",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent && vp run packages:build",
    "site:deploy": "vp run --filter @vibevalley/site deploy",
    "bump": "vpx scripts/release/bump.ts",
    "build:alpha": "vpx scripts/release/build.ts alpha",
    "build:beta": "vpx scripts/release/build.ts beta",
    "build:release": "vpx scripts/release/build.ts release",
    "release": "vpx scripts/release/release.ts",
    "capabilities": "vpx scripts/gen/capabilities.ts",
    "tokens:gen": "vpx scripts/gen/tokens.ts",
    "icons:gen": "vpx scripts/gen/icons.ts",
    "ui:gallery": "vpx scripts/audit/ui-gallery.ts",
    "vdp": "vpx scripts/vdp/run.ts",
    "api:client": "vpx scripts/gen/api-client.ts",
    "i18n:gen": "vpx scripts/gen/i18n.ts gen",
    "nsh:install": "sh scripts/release/install-nsh.sh 0.7.1",
    "branding:dmg": "vpx scripts/gen/mac-branding.ts --dmg-only",
    "package:mac": "vpx scripts/release/package.ts",
    "package:mac:alpha": "vpx scripts/release/package.ts --profile debug --fast --no-dmg --no-zip",
    "package:mac:alpha:dmg": "vpx scripts/release/package.ts --profile debug --fast --no-zip",
    "update-check": "vpx scripts/release/update-check.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vibevalley/i18n": "workspace:*",
    "@vibevalley/protocol": "workspace:*",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
