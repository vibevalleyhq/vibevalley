{
  "name": "vibevalley",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent && vp run packages:build",
    "desktop:dev": "vp run --filter @vibevalley/desktop dev",
    "notes:catalog": "vpx scripts/docs/agent-notes.ts --write",
    "site:deploy": "vp run --filter @vibevalley/site deploy",
    "package:mac": "vp run --filter @vibevalley/desktop package",
    "release": "vpx scripts/release/release.ts",
    "capabilities": "vpx scripts/gen/capabilities.ts",
    "api:client": "vpx scripts/gen/api-client.ts",
    "i18n:gen": "vpx scripts/gen/i18n.ts gen",
    "health": "vpx packages/health/src/cli.ts --config scripts/audit/health.config.ts",
    "health:write": "vpx packages/health/src/cli.ts --config scripts/audit/health.config.ts --write",
    "practice:write": "vpx scripts/audit/practice-audit.ts --write",
    "paths:write": "vpx scripts/audit/service-paths.ts --write"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vibevalley/desktop": "workspace:*",
    "@vibevalley/health": "workspace:*",
    "@vibevalley/i18n": "workspace:*",
    "@vibevalley/protocol": "workspace:*",
    "@vibevalley/server": "workspace:*",
    "@vibevalley/testkit": "workspace:*",
    "eslint-plugin-solid": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
