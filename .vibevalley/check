#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
main=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || printf '%s\n' main)
main=${main#origin/}
base=$(git merge-base "$main" HEAD)
changed=$(git diff --name-only --no-renames "$base")
server=false
web=false
while IFS= read -r path; do
    case "$path" in
        packages/base-ui/*|packages/engine/*|packages/stories/*|packages/health/*|packages/tsrs/*) ;;
        cmd/*|internal/*|pkg/*|go.mod|go.sum|sqlc.yaml|arch_test.go|packages/*) server=true ;;
    esac
    case "$path" in apps/web/*|apps/mobile/*|packages/*) web=true ;; esac
done <<PATHS
$changed
PATHS

# Tests must not inherit the running farm's configuration or smith nesting depth.
for key in $(env | cut -d= -f1); do
    case "$key" in
        VIBEVALLEY_*|OAR_SUBAGENT_DEPTH|DEEPSEEK_API_KEY|AGORA_APP_ID|AGORA_APP_CERTIFICATE) unset "$key" ;;
    esac
done

# Narrowest checks first; vp install's prepare hook runs packages:build.
vp install --frozen-lockfile
vp check --deny-warnings
if "$server"; then
    vp run server:check
fi
if "$web"; then
    vp run web:check
fi
vp run docs:verify
vp run practice:check
vp run health:verify
vp run deadcode
