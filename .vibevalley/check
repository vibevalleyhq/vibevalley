#!/bin/sh
set -eu

toplevel=$(git rev-parse --show-toplevel)
cd "$toplevel"
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ] && command -v sccache >/dev/null 2>&1; then
    export RUSTC_WRAPPER="${RUSTC_WRAPPER:-sccache}"
    export CARGO_INCREMENTAL=0
    export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-40G}"
    export SCCACHE_BASEDIRS="${SCCACHE_BASEDIRS:-$(dirname "$toplevel")}"
fi
main=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || printf '%s\n' main)
main=${main#origin/}
base=$(git merge-base "$main" HEAD)
changed=$(git diff --name-only --no-renames "$base" && git ls-files --others --exclude-standard)
rust=false
packages=false
mac=false
protocol=false
while IFS= read -r path; do
    case "$path" in crates/*|apps/mac/*|xtask/*|Cargo.*) rust=true ;; esac
    case "$path" in packages/*) packages=true ;; esac
    case "$path" in apps/mac/ui/*|packages/*) mac=true ;; esac
    case "$path" in
        crates/protocol/*|crates/core/src/artifact/*|crates/core/tests/artifact_golden.rs|packages/protocol/*) protocol=true ;;
    esac
done <<PATHS
$changed
PATHS

# Tests must not inherit the running farm's configuration or smith nesting depth.
for key in $(env | cut -d= -f1); do
    case "$key" in
        VIBEVALLEY_*|OAR_SUBAGENT_DEPTH|DEEPSEEK_API_KEY|AGORA_APP_ID|AGORA_APP_CERTIFICATE) unset "$key" ;;
    esac
done

# The same checks AGENTS.md asks for, narrowest first: a fresh worktree may not have installed yet.
vp install --frozen-lockfile
vp check --deny-warnings
if "$protocol"; then
    cargo xtask protocol
fi
if "$rust"; then
    cargo xtask check
    cargo xtask audit
fi
if "$packages"; then
    vp run packages:check
fi
if "$mac"; then
    vp run mac:check
fi
# Docs, the notes' catalog and our primitives drift with any change, not only a docs one.
vp run docs:verify
