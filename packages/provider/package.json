{
  "name": "@vibevalley/provider",
  "private": true,
  "type": "module",
  "exports": {
    "./deepseek/models": {
      "types": "./dist/deepseek/models.d.ts",
      "default": "./src/deepseek/models.ts"
    },
    "./deepseek/request": {
      "types": "./dist/deepseek/request.d.ts",
      "default": "./src/deepseek/request.ts"
    },
    "./deepseek/response": {
      "types": "./dist/deepseek/response.d.ts",
      "default": "./src/deepseek/response.ts"
