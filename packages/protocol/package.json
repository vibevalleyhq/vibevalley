{
  "name": "@vibevalley/protocol",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "default": "./src/rules/index.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./src/api.ts"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "default": "./src/rpc.ts"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./src/host.ts"
    }
  },
  "dependencies": {
    "@vibevalley/bridge": "workspace:*",
    "@vibevalley/i18n": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vibevalley/testkit": "workspace:*"
  }
}
