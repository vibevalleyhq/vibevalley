{
  "name": "@vibevalley/agent",
  "private": true,
  "type": "module",
  "exports": {
    "./core/errors": {
      "types": "./dist/core/errors.d.ts",
      "default": "./src/core/errors.ts"
    },
    "./core/schema": {
      "types": "./dist/core/schema.d.ts",
      "default": "./src/core/schema.ts"
    },
    "./core/tool": {
      "types": "./dist/core/tool.d.ts",
      "default": "./src/core/tool.ts"
    },
    "./dag": {
      "types": "./dist/base/dag.d.ts",
      "default": "./src/base/dag.ts"
    },
    "./mcp": {
      "types": "./dist/infra/mcp.d.ts",
      "default": "./src/infra/mcp.ts"
    },
    "./mcpTransport": {
      "types": "./dist/infra/mcpTransport.d.ts",
      "default": "./src/infra/mcpTransport.ts"
    },
    "./memory": {
      "types": "./dist/tools/memory.d.ts",
      "default": "./src/tools/memory.ts"
    },
    "./self": {
      "types": "./dist/tools/self.d.ts",
      "default": "./src/tools/self.ts"
    },
    "./skills": {
      "types": "./dist/tools/skills.d.ts",
      "default": "./src/tools/skills.ts"
    },
    "./todo": {
      "types": "./dist/tools/todo.d.ts",
      "default": "./src/tools/todo.ts"
    },
    "./todoStore": {
      "types": "./dist/tools/todoStore.d.ts",
      "default": "./src/tools/todoStore.ts"
    },
    "./todoTools": {
      "types": "./dist/tools/todoTools.d.ts",
      "default": "./src/tools/todoTools.ts"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@vibevalley/async": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vibevalley/testkit": "workspace:*",
    "vite-plus": "catalog:"
  }
}
