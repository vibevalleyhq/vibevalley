{
  "name": "@vibevalley/server",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#package": "./package.json",
    "#db/*": "./db/generated/*"
  },
  "exports": {
    "./assets": "./src/base/assets.ts",
    "./baseline": "./src/infra/baseline.ts",
    "./chat": "./src/chat/main.ts",
    "./modules": "./src/modules.ts",
    "./testing": "./src/testing/farm.ts"
  },
  "scripts": {
    "start": "vpx src/main.ts",
    "evals": "VIBEVALLEY_EVALS_LIVE=1 vp test run src/modules/orchestrator/evals.live.test.ts",
    "db:generate": "vpx scripts/pg-generate.ts",
    "db:check": "vpx scripts/pg-generate.ts --check",
    "chat": "vpx src/chat/main.ts"
  },
  "dependencies": {
    "@botiverse/oar": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@larksuiteoapi/node-sdk": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@vibevalley/agent": "workspace:*",
    "@vibevalley/ai": "workspace:*",
    "@vibevalley/artifact": "workspace:*",
    "@vibevalley/home": "workspace:*",
    "@vibevalley/i18n": "workspace:*",
    "@vibevalley/pkm": "workspace:*",
    "@vibevalley/protocol": "workspace:*",
    "@vibevalley/provider": "workspace:*",
    "agora-agents": "catalog:",
    "effect": "catalog:",
    "music-metadata": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vibevalley/testkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
