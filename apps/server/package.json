{
  "name": "@vibevalley/server",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#db/*": "./db/generated/*"
  },
  "exports": {
    "./assets": "./src/assets.ts",
    "./baseline": "./src/infra/baseline.ts",
    "./modules": "./src/modules.ts"
  },
  "scripts": {
    "start": "vpx src/main.ts",
    "cli": "vpx src/cli.ts",
    "evals": "VIBEVALLEY_EVALS_LIVE=1 vp test run src/orchestrator/evals.live.test.ts",
    "db:generate": "vpx scripts/sqlite-generate.ts",
    "db:check": "vpx scripts/sqlite-generate.ts --check"
  },
  "dependencies": {
    "@botiverse/oar": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@larksuiteoapi/node-sdk": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@vibevalley/agent": "workspace:*",
    "@vibevalley/ai": "workspace:*",
    "@vibevalley/bridge": "workspace:*",
    "@vibevalley/home": "workspace:*",
    "@vibevalley/i18n": "workspace:*",
    "@vibevalley/protocol": "workspace:*",
    "agora-agents": "catalog:",
    "agora-token": "catalog:",
    "effect": "catalog:",
    "parse5": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vibevalley/testkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
