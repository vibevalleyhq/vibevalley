      },
      "text": {
        "description": "到点时说的话：要做的事",
        "type": "string"
      },
      "time": {
        "description": "HH:MM",
        "type": "string"
      },
      "tz": {
        "description": "时区，比如 Asia/Shanghai；不填是这台电脑的",
        "type": "string"
      }
