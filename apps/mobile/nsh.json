{
  "name": "VibeValley",
  "id": "dev.vibevalley.mobile",
  "version": "0.1.0",
  "build": 1,
  "capabilities": {
    "application": true,
    "clipboard": true,
    "host": ["keychain.get", "keychain.set", "keychain.delete"],
    "notifications": true,
    "statusBar": true,
    "network": {
      "hosts": ["*"]
    }
  },
  "theme": "design/theme.json",
  "schemes": ["vibevalley"],
  "android": {
    "usesCleartextTraffic": true
  },
  "tailwind": {
    "fontSize": {
      "2xs": [11, 1.2727],
      "xs": [12, 1.3333],
      "sm": [13, 1.5385],
      "base": [14, 1.5714],
      "lg": [16, 1.5],
      "xl": [20, 1.4],
      "2xl": [24, 1.3333],
      "3xl": [30, 1.2]
    },
    "radius": {
      "xs": 3,
      "sm": 4,
      "md": 6,
      "lg": 8,
      "xl": 12
    },
    "ease": {
      "out": [0.2, 0, 0, 1],
      "in": [0.4, 0, 1, 1],
      "in-out": [0.4, 0, 0.2, 1],
      "spring": [0.34, 1.4, 0.64, 1]
    },
    "fontFamily": {
      "sans": "PingFang SC",
      "mono": "Menlo"
    },
    "shadow": {
      "float": "0 8px 24px #0000002e",
      "raise": "0 1px 2px #00000018",
      "toggle-thumb": "0 1px 3px 0 #0000001a, 0 1px 2px -1px #0000001a"
    }
  }
}
