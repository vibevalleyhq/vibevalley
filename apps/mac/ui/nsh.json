{
  "name": "vibevalley-ui",
  "id": "dev.vibevalley.ui",
  "version": "0.1.0",
  "build": 1,
  "capabilities": {
    "host": ["action", "ready"],
    "clipboard": true,
    "audio": true,
    "fs": {
      "read": ["${homeDir}"]
    },
    "picker": true,
    "webview": {}
  },
  "theme": "vv/theme.json",
  "tailwind": {
    "fontSize": {
      "2xs": [11.0, 1.2727],
      "xs": [12.0, 1.3333],
      "sm": [13.0, 1.5385],
      "base": [14.0, 1.5714],
      "lg": [16.0, 1.5],
      "xl": [20.0, 1.4],
      "2xl": [24.0, 1.3333],
      "3xl": [30.0, 1.2]
    },
    "radius": {
      "xs": 3.0,
      "sm": 4.0,
      "md": 6.0,
      "lg": 8.0,
      "xl": 12.0
    },
    "ease": {
      "out": [0.2, 0.0, 0.0, 1.0],
      "in": [0.4, 0.0, 1.0, 1.0],
      "in-out": [0.4, 0.0, 0.2, 1.0],
      "spring": [0.34, 1.4, 0.64, 1.0]
    },
    "fontFamily": {
      "sans": "PingFang SC",
      "mono": "Menlo",
      "pixel": "FusionPixel"
    },
    "shadow": {
      "float": "0 8px 24px #1c191724",
      "raise": "0 1px 2px #1c191714",
      "toggle-thumb": "0 1px 3px 0 #0000001a, 0 1px 2px -1px #0000001a",
      "px": "2px 2px 0 #1e140a73"
    }
  }
}
